		"react-dom": "19.3.0",
		"react-markdown": "^10.1.0",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"tailwind-merge": "^3.7.0",
		"torph": "0.1.3",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
