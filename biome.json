{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!cloudflare-env.d.ts"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useSortedClasses": {
					"level": "info",
					"fix": "safe",
					"options": {
						"attributes": ["classList"],
						"functions": ["clsx", "cva", "tw", "tw.*", "cn"]
					}
				}
			},
			"correctness": {
				"noUnusedImports": {
					"level": "info",
					"fix": "safe"
				}
			},
			"suspicious": {
				"noExplicitAny": {
					"level": "off"
				},
				"noArrayIndexKey": {
					"level": "off"
				}
			}
		},
		"domains": {
			"next": "all",
			"react": "all",
			"project": "recommended"
		}
	},
	"overrides": [
		{
			"includes": ["src/app/**/*.{ts,tsx}", "src/components/ui/**/*.{ts,tsx}"],
			"linter": {
				"rules": {
					"style": {
						"useComponentExportOnlyModules": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
